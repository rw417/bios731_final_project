## Cross-Modality Single Cell Integration

```{r matrix-grid, eval=TRUE, echo=FALSE, fig.align='center', fig.width=12, fig.height=7}
library(ggplot2)
library(gridExtra)
library(dplyr)

# Create matrix layout
n_row <- 25
n_col <- 10

# Plot matrix grid for RNA-seq
mat_df_a <- expand.grid(
  row = 1:n_row,
  col = 1:n_col
) %>%
  mutate(
    label = paste0("(", row, ",", col, ")"),
    highlight = ifelse(row == 2, "maroon", ifelse(row==21, "navy", "white"))
  )

plot_a <- ggplot(mat_df_a, aes(x = col, y = row)) +
  geom_tile(aes(fill = highlight), color = "black", linewidth = 0.6) +
  scale_fill_identity() +  # use colors directly from 'highlight' column
  coord_fixed() +
  theme_void() + 
  labs(x = "RNA Expression", y = "Cell ID", title="Single Cell RNA-seq Data") +
  theme_minimal(base_size = 16) +
  theme(
    plot.title = element_text(size = 22, hjust = 0.5),
    axis.title = element_text(size = 16),
    axis.text = element_blank(),         # ❌ hide tick labels
    axis.ticks = element_blank(),        # ❌ hide tick marks
    panel.grid = element_blank(),        # ❌ hide grid lines
  )

mat_df_b <- expand.grid(row = n_row:1, col = 1:n_col) %>%
  mutate(
    label = paste0("(", row, ",", col, ")"),
    highlight = ifelse(row == 12, "maroon", ifelse(row==3, "navy", "white"))
  )

plot_b <- ggplot(mat_df_b, aes(x = col, y = row)) +
  geom_tile(aes(fill = highlight), color = "black", linewidth = 0.6) +
