## Simulation Results: By Noise Level

```{r, eval=TRUE, echo=FALSE, warnings=FALSE, fig.align='center', fig.width=14, fig.height=7}
noise_level_results <- readRDS(here::here("30_results", "noise_level_results.rds"))

p1 <- ggplot(noise_level_results, aes(y = factor(noise_level), x = correct, fill = method)) +
  geom_boxplot() +
  labs(title = "Correctness of LAP Algorithms by Noise Level",
       y = "Noise Level",
       x = "Correctness") +
  theme_minimal() +
  scale_fill_brewer(palette = "Set2", name = "Method") +
  theme(legend.position = "right")

p2 <- ggplot(noise_level_results, aes(y = factor(noise_level), x = log10(time), fill = method)) +
  geom_boxplot() +
  labs(title = "Computation Times by Noise Level",
       y = "Noise Level",
       x = "Log Computation Time (microseconds)") +
  theme_minimal() +
  scale_fill_brewer(palette = "Set2", name = "Method") +
  theme(legend.position = "right")

grid.arrange(p1, p2, ncol = 2)
```

