# Source modules and read packages ####
source(here::here("10_source", "generate_synthetic_data.R"))
source(here::here("10_source", "hungarian_algorithm.R"))
source(here::here("10_source", "jv_algorithm.R"))

# Function to run simulations by defining data size and noise level
run_sim <- function(n_rows, n_cols, noise_level, iter){
  correct_hungarian <- numeric(iter)
  correct_jv <- numeric(iter)
  correct_auction <- numeric(iter)
  
  time_hungarian <- numeric(iter)
  time_jv <- numeric(iter)
  time_auction <- numeric(iter)
  
  # These algorithms are deterministic, so we need to simulate a new data set every time
  for(i in 1:iter){
    # Gen synthetic data
    A_B <- gen_synthetic_data(n_rows = n_rows, n_cols = n_cols, noise_level = noise_level)
    A <- A_B[[1]]
    B <- A_B[[2]]
    # Shuffle B
    B_shuffled <- B[sample(1:nrow(B)), ]
    
    # Calculate cost, defined as row-wise correlation
    cost_matrix <- cor(t(A), t(B_shuffled))
    # Transform cost matrix so that we maximize cost_matrix 
    # by minimizing cost_matrix_transformed
    cost_matrix_transformed <- max(cost_matrix) - cost_matrix
    
    # Hungarian timing
    t1 <- Sys.time()
    hungarian_assign <- run_hungarian(cost_matrix_transformed)
    t2 <- Sys.time()
    time_hungarian[i] <- difftime(t2, t1, units="secs") * 1e6
    correct_hungarian[i] <- sum(B_shuffled[hungarian_assign,1] == B[,1]) / n_rows
    
    # JV timing
    t1 <- Sys.time()
    jv_assign <- run_jv(cost_matrix_transformed)
    t2 <- Sys.time()
    time_jv[i] <- difftime(t2, t1, units="secs") * 1e6
    correct_jv[i] <- sum(B_shuffled[jv_assign$matching,1] == B[,1]) / n_rows
    
    # Auction timing
    epsilon_value = 1/n_rows
    t1 <- Sys.time()
    auction_assign <- run_auction(cost_matrix, epsilon=epsilon_value)
    t2 <- Sys.time()
    time_auction[i] <- difftime(t2, t1, units="secs") * 1e6
    correct_auction[i] <- sum(B_shuffled[auction_assign$assignment,1] == B[,1]) / n_rows
  }
  
  # Create a dataframe to store results
  # columns: method, correct, time, n_rows, n_cols, noise_level, iter
  results <- data.frame(
    method = rep(c("Hungarian", "JV", "Auction"), each = iter),
    correct = c(correct_hungarian, correct_jv, correct_auction),
    time = c(time_hungarian, time_jv, time_auction),
    n_rows = rep(n_rows, 3 * iter),
    n_cols = rep(n_cols, 3 * iter),
    noise_level = rep(noise_level, 3 * iter),
    iter = rep(1:iter, 3)
  )
  return(results)
}



