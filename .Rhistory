install.packages("adagio")
library(adagio)
gen_synthetic_data <- function(n_rows, n_cols, noise_level=0.5) {
# Generate matrix A
A <- matrix(rnorm(n_rows * n_cols), nrow = n_rows, ncol = n_cols)
# Generate matrix B by adding small noise
B <- A + matrix(rnorm(n_rows * n_cols, sd = noise_level), nrow = n_rows, ncol = n_cols)
return(list(A = A, B = B))
}
A_B <- gen_synthetic_data(n_rows = 100, n_cols = 25, noise_level = 0.5)
A <- A_B[[1]]
B <- A_B[[2]]
A
B
run_hungarian <- function(cost_matrix){
clue::solve_LSAP(cost_matrix)
}
cost_matrix <- cor(t(A), t(B))
dim(cost_matrix)
run_hungarian(cost_matrix)
cost_matrix_transformed <- max(cost_matrix) - cost_matrix
run_hungarian(cost_matrix_transformed)
B_shuffled <- B[sample(1:nrow(B)), ]
cost_matrix <- cor(t(A), t(B_shuffled))
cost_matrix_transformed <- max(cost_matrix) - cost_matrix
run_hungarian(cost_matrix_transformed)
hungarian_assign <- run_hungarian(cost_matrix_transformed)
hungarian_assign
B_shuffled[hungarian_assign,]
B_shuffled[hungarian_assign,1] == B[,1]
B_shuffled[,1] == B[,1]
run_jv <- function(cost_matrix){
adagio::assignment(cost_matrix)
}
jv_assign <- run_jv(cost_matrix_transformed)
jv_assign
jv_assign$perm
B_shuffled[jv_assign$perm,1] == B[,1]
